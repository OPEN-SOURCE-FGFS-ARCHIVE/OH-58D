		<rotor>
			<name>rotor-outside</name>
			<mode>looped</mode>
			<path>Aircraft/OH-58D/Sounds/geed/rotor_exterior_loop.wav</path>
			<condition>
				<and>
					<not>
						<property>sim/current-view/internal</property>
					</not>
					<greater-than>
						<property>rotors/main/rpm</property>
