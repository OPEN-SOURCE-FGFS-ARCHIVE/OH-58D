-->

<PropertyList>

	<fx>

		<!-- Weapons -->
		
		<!-- Gun -->
		
		<guns>
			<name>Gun</name>
			<mode>looped</mode>
			<path>Aircraft/OH-58D/Sounds/geed/exterior_gun_loop.wav</path>
			
			<condition>
				<property>controls/armament/trigger</property>
			</condition>
			
			<volume>
				<factor>1.2</factor>
				<max>1.0</max>
			</volume>
			
			<reference-dist>100</reference-dist>
			<max-dist>1000</max-dist>
		</guns>

		<!-- Hydra  -->
		
		<hydra>
			<name>hydra</name>
			<condition>
				<property>controls/armament/trigger1</property>
			</condition>
			<path>Aircraft/OH-58D/Sounds/Missile.wav</path>
		</hydra>

		<!-- Stinger  -->
		
		<stinger>
			<name>stinger</name>
